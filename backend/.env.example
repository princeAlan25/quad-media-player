PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Optional AI analysis for system-scanned images and smaller videos.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=openai/gpt-4.1-mini
OPENROUTER_HTTP_REFERER=http://localhost:4000
OPENROUTER_APP_TITLE=Quad Media Player Backend

# Set to false to disable new analysis requests while keeping cached analysis.
MEDIA_ANALYSIS_ENABLED=true
MEDIA_ANALYSIS_MAX_ITEMS_PER_SCAN=24
MEDIA_ANALYSIS_MAX_IMAGE_BYTES=8388608
MEDIA_ANALYSIS_MAX_VIDEO_BYTES=20971520
